# HTTP port (Railway injects this automatically)
PORT=3000

# SQLite file location. On Railway, point this at the mounted volume, e.g. /data/patients.db
DB_PATH=./data/patients.db

# Shared secret Vapi sends in the x-vapi-secret header on every webhook call.
# Set the same value as the "Server URL Secret" in the Vapi dashboard.
VAPI_WEBHOOK_SECRET=

# --- Vapi provisioning (used only by `npm run vapi:setup`, not by the server) ---
# Private API key from dashboard.vapi.ai -> API Keys
VAPI_API_KEY=
# Public HTTPS base URL of this server (Railway URL); the webhook is <base>/vapi/webhook
PUBLIC_BASE_URL=
# Optional overrides
VAPI_MODEL=gpt-4.1
VAPI_VOICE_ID=Elliot
VAPI_TRANSCRIBER_LANGUAGE=multi
# Area code for the free Vapi US number (only needed the first time)
VAPI_PHONE_AREA_CODE=
