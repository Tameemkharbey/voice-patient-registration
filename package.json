{
  "name": "voice-patient-registration",
  "version": "1.0.0",
  "description": "Voice AI agent for conversational patient registration (Vapi + Express + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vapi:setup": "tsx src/scripts/vapiSetup.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
